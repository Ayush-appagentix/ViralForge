# Copy this file to .env and fill in what you use. Never share .env.

# Meta (Facebook Pages + Instagram) - from developers.facebook.com > your app > App settings > Basic
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v27.0

# LinkedIn - from linkedin.com/developers > your app > Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202611

# YouTube needs no keys here: save the Google OAuth client file as secrets/google_client_secret.json

# Video transcription (local, free). Bigger = more accurate but slower: base | small | medium
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=en

# Instagram images are hosted for Instagram by uploading them unpublished to your Facebook Page.
# If that ever fails, set this to use a free temporary public host instead (opt-in):
# IG_IMAGE_HOST=litterbox
